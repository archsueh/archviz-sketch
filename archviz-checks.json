{
  "skill_md": "SKILL.md",
  "skill_md_max_bytes": 20000,
  "require_lf_pin": true,
  "version": {
    "changelog": "CHANGELOG.md",
    "pyproject": "pyproject.toml"
  },
  "registries": {
    "styles": {
      "kind": "source_regex",
      "file": "archviz_sketch/engine.py",
      "block": "^STYLE_REGISTRY = \\{(.*?)^\\}",
      "block_flags": "MS",
      "entry": "^\\s{4}\"([\\w-]+)\":\\s*\\{",
      "flags": "M"
    }
  },
  "routing": {
    "registries": [
      "styles"
    ],
    "also_check_triggers": false
  },
  "counts": [
    {
      "id": "styles_declared",
      "truth": {
        "kind": "registry_len",
        "registry": "styles"
      },
      "assertions": [
        {
          "file": "SKILL.md",
          "regex": "(\\d+)\\s*种风格（"
        }
      ]
    },
    {
      "id": "styles_implemented_table_rows",
      "truth": {
        "kind": "markdown_table_rows",
        "file": "SKILL.md",
        "section": "风格总览",
        "entry": "^\\|\\s*\\*\\*(?!.*未实现)"
      },
      "assertions": [
        {
          "file": "SKILL.md",
          "regex": "(\\d+)\\s*种风格（已实现"
        }
      ]
    },
    {
      "id": "prompt_templates",
      "truth": {
        "kind": "glob_count",
        "globs": [
          "templates/prompts/*.md"
        ]
      },
      "assertions": [
        {
          "file": "SKILL.md",
          "regex": "(\\d+)\\s*套模板"
        }
      ]
    }
  ],
  "coverage": [
    {
      "id": "reference_index",
      "indexed_in": "SKILL.md",
      "globs": [
        "references/**/*.md"
      ]
    }
  ],
  "deps": {
    "requirements": "requirements.txt",
    "pyproject": "pyproject.toml",
    "python_roots": [
      "scripts",
      "archviz_sketch"
    ],
    "self_packages": [
      "archviz_sketch"
    ],
    "map": {
      "PIL": "Pillow"
    }
  },
  "pycompile": {
    "globs": [
      "**/*.py"
    ]
  },
  "cjk": {
    "scan": [
      "SKILL.md",
      "README.md",
      "CHANGELOG.md",
      "references/**/*.md",
      "templates/prompts/*.md",
      "demo.html",
      "demo-styles.html"
    ],
    "require_charset": [
      "demo*.html"
    ]
  },
  "prose": {
    "files": [
      ".github/workflows/ci.yml",
      "scripts/git-pre-commit.sh"
    ],
    "count_regex": "\\b(?:one|two|three|four|five|six|seven|eight|nine|ten|\\d+)\\s+checks?\\b"
  },
  "shared": [
    {
      "path": "references/design-judgment.md",
      "sha256": "fce284d7137d0ec8499a01f65aa8771aeadf55d07954822255b7695a6a206cdc"
    }
  ]
}
